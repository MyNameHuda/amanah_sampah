# =============================================================================
# TEMPLATE ENVIRONMENT PRODUCTION — Amanah Sampah
# =============================================================================
# Salin file ini menjadi `.env` di server, lalu isi nilainya.
# JANGAN commit `.env` yang sudah terisi (sudah masuk .gitignore).
#
# Generate APP_KEY:
#   php artisan key:generate --show
# =============================================================================

# --- Aplikasi ----------------------------------------------------------------
APP_NAME="Amanah Sampah"
APP_ENV=production

# WAJIB diisi. Kalau kosong, semua request yang butuh enkripsi gagal.
# Generate: php artisan key:generate --show
APP_KEY=

# WAJIB false di produksi. true = dump seluruh stack trace + variabel env
# ke response saat ada error. Ini membocorkan APP_KEY & kredensial DB.
APP_DEBUG=false

# Domain produksi TANPA trailing slash. Dipakai Sanctum & link di email.
APP_URL=https://amanah.example.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

# --- Keamanan & performa -----------------------------------------------------
# 12 = bcrypt cost standar. Turunkan hanya kalau server terasa lambat.
BCRYPT_ROUNDS=12

# Cookie session di-backup ke database. Kalau dipakai Redis/cookie, biarkan
# 'file' supaya session tidak hilang saat cache di-flush.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
# WAJIB true di produksi — Sanctum menolak cookie non-HTTPS.
SESSION_SAME_SITE=lax

# --- Database ----------------------------------------------------------------
# SQLite: file, tidak perlu server DB, tidak ada network hop. Cukup untuk
# puluhan ribu baris (jauh di atas kebutuhan 51 siswa).
# WAJIB: file database harus berada di persistent disk, BUKAN di /tmp.
DB_CONNECTION=sqlite
# DB_HOST / DB_PORT / DB_USERNAME / DB_PASSWORD tidak dipakai oleh sqlite.
#
# Kalau suatu saat pindah ke PostgreSQL, SuperAdminController::getDatabaseSizeKb()
# sudah driver-aware (sqlite/pgsql/mysql), jadi endpoint health tidak akan 500.
# DB_CONNECTION=pgsql
# DB_HOST=...
# DB_PORT=5432
# DB_DATABASE=...
# DB_USERNAME=...
# DB_PASSWORD=...

# --- Cache, queue, session ----------------------------------------------------
# Semua pakai driver database: tidak butuh Redis sama sekali. Ini keputusan
# sadar — lihat DEPLOYMENT.md, bagian "Kenapa tidak pakai Redis".
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log

FILESYSTEM_DISK=local

# --- Logging -----------------------------------------------------------------
# daily + 14 hari: cukup untuk operasional sekolah, tidak eating disk.
# Kalau pakai `stack` di produksi, single file akan tumbuh tanpa batas.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info
# LOG_DAILY_DAYS=14

# --- Maintenance mode --------------------------------------------------------
# `file` menulis ke storage/framework/down — aman & tidak butuh cache driver.
APP_MAINTENANCE_DRIVER=file

# --- Rate limiting -----------------------------------------------------------
# Default Laravel: 60 req/menit per user untuk API. Kalau 403 muncul
# tak terduga saat staff memindai barcode cepat, naikkan angka ini.
# RateLimiter::for('login') ada di AppServiceProvider — cek bila perlu ubah.

# --- Cron / scheduler --------------------------------------------------------
# Dijalankan oleh crontab di server:
#   * * * * * cd /path/ke/prototype && php artisan schedule:run >> /dev/null 2>&1
# Command yang dijadwalkan: amanah:archive-audit (bulanan), amanah:purge-expired-tokens (harian)
# Scheduler ini memanggil APP_URL, jadi pastikan APP_URL benar & bisa diakses
# dari server itu sendiri.

# --- Trust proxy -------------------------------------------------------------
# WAJIB 1 kalau di belakang Nginx/Apache/CDN, supaya secure() & URL absolut
# benar. Kalau dikosongkan, link https:// di halaman mungkin jadi http://.
TRUSTED_PROXIES=*

# --- Redis (tidak dipakai, tapiiada supaya tidak error konfigurasi) ---------
# Kalau suatu saat butuh Redis, hapus driver database di atas.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Mail --------------------------------------------------------------------
# Default `log` = tidak kirim email, ditulis ke log saja. Aman untuk produksi
# awal karena tidak bisa membocorkan kredensial SMTP.
# Kalau butuh kirim email (reset password admin), isi SMTP provider sungguhan.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@amanah.example.com"
MAIL_FROM_NAME="${APP_NAME}"
# MAIL_SCHEME=null
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
