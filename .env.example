# =============================================================
# Environment variables — SALIN ke Vercel (Settings → Environment Variables)
# JANGAN pernah isi nilai aslinya di file ini. File ini hanya referensi.
# =============================================================

# --- Database (Neon) ---
# WAJIB. Ambil yang berlabel "Pooled connection" dari Neon console.
# URL ini sampai ke Vercel Functions sebagai DATABASE_URL.
DATABASE_URL=

# --- Auth ---
# WAJIB. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Minimal 32 byte. kalau diganti, semua token lama jadi tidak valid.
JWT_SECRET=

# --- Super admin awal (HAPUS setelah provisioning) ---
# Dipakai oleh POST /api/setup/bootstrap-admin
# Syarat password: min 12 karakter + huruf besar + kecil + angka
# DAN tidak boleh sama dengan password di DatabaseSeeder.php (publik di repo).
BOOTSTRAP_ADMIN_NAME=Super Admin Sekolah
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# --- Storage foto bukti (Supabase S3-compatible) ---
# WAJIB. Bucket harus PUBLIC karena frontend membuka URL foto langsung.
# AWS_URL harus URL PUBLIK bucket, BUKAN endpoint S3.
#   Supabase : https://<ref>.supabase.co/storage/v1/object/public/<bucket>
#   Cloudflare: https://<bucket>.<xxxx>.r2.dev
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT=
AWS_BUCKET=amanah-bukti
AWS_URL=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_USE_PATH_STYLE_ENDPOINT=true

# --- Frontend (harus di-prefix VITE_ agar terbaca Vite) ---
# Kosongkan kalau SPA dan API di domain sama (recommended).
# Isi hanya kalau frontend di-host terpisah, mis. Cloudflare Pages:
#   VITE_API_BASE_URL=https://api.domain-anda.com/api
VITE_API_BASE_URL=

# --- Legacy Laravel (hanya untuk migrasi bertahap) ---
# Setelah migrasi selesai, hapus semua DB_* dan render.yaml.
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
