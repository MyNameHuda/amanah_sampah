{
  "name": "amanah-sampah",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Amanah Sampah — sistem deposit-refund non-moniter pengelolaan sampah plastik pesantren. Frontend React SPA + backend TypeScript (Vercel Functions) dalam satu project.",
  "scripts": {
    "dev": "vite",
    "dev:api": "vercel dev",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "preview": "vite preview",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@neondatabase/serverless": "^0.10.4",
    "@types/ws": "^8.18.1",
    "@vercel/node": "^3.2.29",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.38.3",
    "jose": "^5.9.6",
    "lucide-react": "^1.47.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "ws": "^8.22.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.30.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "engines": {
    "node": ">=20"
  }
}
